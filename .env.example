# Location of the static site files
SITE_DIR=./public
# The URL of your site, used for sitemap generation
SITE_URL=
# Default changefreq and priority for each sitemap entry
SITEMAP_CHANGEFREQ_DEFAULT=monthly
SITEMAP_PRIORITY_DEFAULT=0.5
# Whether to cleanup generated files (sitemap and robots.txt) after deployment if newly created
CLEANUP_GENERATED_FILES=false
